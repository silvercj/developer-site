// Cloudflare Workers static site (assets only, no worker code), following the
// Borderline pattern. Deploy with `npx wrangler deploy`. "name" must match the
// Worker project name in the Cloudflare dashboard.
{
  "name": "developer-site",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    // /oneless/privacy resolves to /oneless/privacy/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
